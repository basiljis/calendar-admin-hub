# Реальные значения этого проекта — готовы к копированию в настройки Timeweb Cloud Apps
# (Settings → Variables) или в .env.deploy для локального docker compose.

# Домены
APP_DOMAIN=psygrafik.ru
API_DOMAIN=api.psygrafik.ru

# Куда edge-прокси ходит за Supabase (сервер-в-сервер)
SUPABASE_UPSTREAM=muuthcezvdaltiylcssh.supabase.co

# Фронт (запекается в бандл на этапе сборки) — идёт через собственный прокси
VITE_SUPABASE_URL=https://api.psygrafik.ru
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FFHC63ee28cD2WTX-nz5pQ_2wS1byHf
VITE_SUPABASE_PROJECT_ID=muuthcezvdaltiylcssh

# Серверная часть SSR / server functions (runtime, не попадает в браузер)
SUPABASE_URL=https://api.psygrafik.ru
SUPABASE_PUBLISHABLE_KEY=sb_publishable_FFHC63ee28cD2WTX-nz5pQ_2wS1byHf

# Необязательно. Нужен только для админ-операций на сервере (создание пользователей и т.п.).
# Приложение работает и без него. На Lovable Cloud этот ключ недоступен — оставьте пустым.
SUPABASE_SERVICE_ROLE_KEY=
