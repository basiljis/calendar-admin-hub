# -- Edge nginx: единственный контейнер, который публикуется наружу.
# -- 1) Проксирует основной домен на SSR-приложение (app:8080) с авто-заглушкой.
# -- 2) Проксирует api.<домен> на Supabase (обход блокировок: браузер ходит только на РФ-домен).

resolver 127.0.0.11 8.8.8.8 1.1.1.1 ipv6=off valid=10s;
resolver_timeout 10s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream app_upstream {
    server app:8080 max_fails=2 fail_timeout=5s;
    keepalive 32;
}

# ---------------------------------------------------------------- API proxy
server {
    listen 8080;
    server_name ${API_DOMAIN};

    set $supabase_upstream "${SUPABASE_UPSTREAM}";

    client_max_body_size 50m;

    location / {
        set $cors_origin "";
        if ($http_origin ~* ^https?://(localhost(:[0-9]+)?|(www\.)?${APP_DOMAIN}|.*\.lovable\.(app|dev))$) {
            set $cors_origin $http_origin;
        }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      "$cors_origin" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods     "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers     "authorization, apikey, content-type, x-client-info, x-supabase-api-version, range, prefer, accept-profile, content-profile, x-requested-with" always;
            add_header Access-Control-Max-Age           "86400" always;
            add_header Content-Length 0;
            return 204;
        }

        # Supabase сам отдаёт CORS — скрываем, чтобы не было дублей
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;

        add_header Access-Control-Allow-Origin      "$cors_origin" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods     "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers     "authorization, apikey, content-type, x-client-info, x-supabase-api-version, range, prefer, accept-profile, content-profile, x-requested-with" always;
        add_header Access-Control-Expose-Headers    "content-range, content-length, x-supabase-api-version" always;
        add_header Cache-Control "no-store" always;

        proxy_pass https://$supabase_upstream$request_uri;

        proxy_ssl_server_name on;
        proxy_ssl_name        $supabase_upstream;
        proxy_set_header Host $supabase_upstream;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# ------------------------------------------------------------- App (SSR/SPA)
server {
    listen 8080 default_server;
    server_name _;

    client_max_body_size 50m;

    location = /__edge_health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /maintenance.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location / {
        # Ручной режим обслуживания: touch /etc/nginx/flags/maintenance.enabled
        if (-f /etc/nginx/flags/maintenance.enabled) {
            return 503;
        }

        proxy_pass http://app_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 3s;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @maintenance;
    }

    location @maintenance {
        root /usr/share/nginx/html;
        add_header Retry-After 900 always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        error_page 503 /maintenance.html;
        return 503;
    }
}
